# Required: choose a long invitation code and share it only with friends.
INVITE_CODE=replace-with-your-private-invite-code
# Set your actual URL, without a trailing slash. Leave empty for local/LAN HTTP.
PUBLIC_ORIGIN=
# Set true when serving through an HTTPS reverse proxy.
COOKIE_SECURE=false
# Keep loopback when using a reverse proxy; use 0.0.0.0 for direct LAN access.
BIND_ADDRESS=127.0.0.1
PORT=8080
# Optional HTTPS directory for separately hosted card and board artwork.
ASSETS_BASE_URL=

# Promote ONE existing account to permanent administrator (preserves its password).
# Configure privately on the server; this role persists in the database.
ADMIN_EXISTING_USERNAME=
# Alternatively, bootstrap a NEW permanent account. Do not combine with the above.
# Password: 16–72 bytes. Changing it here rotates the root password on restart.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional wish reference images. Set all four OSS values to enable uploads;
# text-only wishes keep working when these are empty. Keep the keys private.
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Public CDN base that maps directly to OSS object keys, and the upload prefix.
WISH_IMAGE_BASE_URL=https://cdn.ichenj.com
WISH_IMAGE_PREFIX=bga/wishes
# Read-only token for the local build agent. At least 16 bytes; leave empty to disable.
WISH_AGENT_TOKEN=
