# Required: choose a long invitation code and share it only with friends.
INVITE_CODE=replace-with-your-private-invite-code
# Set your actual URL, without a trailing slash. Leave empty for local/LAN HTTP.
PUBLIC_ORIGIN=
# Set true when serving through an HTTPS reverse proxy.
COOKIE_SECURE=false
# Keep loopback when using a reverse proxy; use 0.0.0.0 for direct LAN access.
BIND_ADDRESS=127.0.0.1
PORT=8080
