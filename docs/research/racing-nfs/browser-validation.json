  "pixelPNGCount": 251,
  "harnessFixes": [
    "CDP硬冻结仅放最后独立过期门槛；后续不再从hidden renderer测输入或帧率。",
    "手机布局、截图与触摸在CDP coarse仿真连接存活时采集；等待目标真实可见并核对elementFromPoint命中。",
    "R前按住真实S直到权威canReset；复位真实2秒结束后测触摸。持油门900ms只用于确认真实起步，不作为像素延迟。",
    "公开改键选择器保留中文，保存按钮先滚入视口；新房间键盘输入前聚焦canvas。",
    "会话前缀缩短，保持UNIX socket路径在限制内。",
    "仅复用failed run中明确PASS的check；逐项绑定同一dist和已记录赛车web/server源码摘要，原run的passed=false保留。"
  ],
  "limitations": [
    "320px Chromium触屏仿真不等同实体手机GPU测量。",
    "Gamepad只替换navigator.getGamepads硬件入口；生产映射/采样/HTTP真实执行，未实测实体USB或蓝牙手柄。",
    "Chrome以--mute-audio启动；验证原生HTMLAudio解码、currentTime、rate、volume和可信事件，未作扬声器听音。",
    "使用双向有序TCP延迟与真实socket中断，未声称测试真实IP丢包。",
    "浏览器验收不证明与Windows原版操控逐项等价；本轮未取得原版运行手感/音频输出对照测量。",
    "本轮PC及320全屏均走native路径；未强制测试page fallback。",
    "多阶段聚合通过；没有将任何failed run整体改记为通过。",
    "本浏览器报告验证新建用户的默认配置与公开改键；旧用户控制器配置迁移由单列真实HTTP/SQLite E2E验证，不计入本报告的通过断言。"
  ],
  "cleanup": {
    "allMappedRunsClosedFixtureAndBrowser": true,
    "allMappedRunsCleanupErrors": [],
    "taskSocketDirectoriesRemaining": []
  },
  "reproduce": [
    "python3 -B scripts/racing/check-nfs.py --out .local/racing-nfs-browser/<new-full-name> --phase full",
    "python3 -B scripts/racing/check-nfs.py --out .local/racing-nfs-browser/<new-fullscreen-name> --phase fullscreen"
  ],
  "separatePlatformValidation": {
    "scope": "共享控制器旧配置迁移",
    "method": "真实HTTP/SQLite E2E",
    "includedInBrowserPass": false,
    "coveredByRacingSourceHashes": false
  }
}
