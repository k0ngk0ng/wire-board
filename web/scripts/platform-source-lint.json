{
  "scope": "Only explicitly registered platform TypeScript/JavaScript/JSON/Go/CSS files and Git-added lines of registered existing files; no game imports or game execution, with the shared Go AST lint helper reused without running game code",
  "sources": [
    "web/src/audio-spatial.ts",
    "web/src/game-api/default-players.ts",
    "web/src/game-api/loading-session.ts",
    "web/tests/loading-session.test.mjs",
    "web/tests/loading-rematch-browser.mjs",
    "web/scripts/platform-source-lint.mjs",
    "web/scripts/platform-source-lint.json",
    "web/tests/game-default-players.test.mjs",
    "web/tests/platform-source-lint.test.mjs",
    "web/src/game-api/action-scope.ts",
    "web/tests/action-scope.test.mjs",
    "web/scripts/numeric-comparisons.mjs",
    "web/tests/numeric-comparisons.test.mjs",
    "web/tests/realtime-game-decoder.test.mjs",
    "web/tests/platform-audio-unlock.test.mjs",
    "web/tests/audio-unlock-browser.mjs",
    "web/tests/transient-audio-browser.mjs",
    "web/src/game-api/resident-assets.ts",
    "web/src/game-api/resident-worker.ts",
    "web/src/game-api/resident-resource-plan.ts",
    "web/tests/resident-assets-browser.mjs",
    "web/tests/resident-resource-plan.test.mjs",
    "web/tests/resident-source-lint.test.mjs",
    "web/scripts/game-load-manifest.mjs",
    "web/tests/game-load-manifest.test.mjs",
    "web/src/game-api/load-assets.ts",
    "web/src/game-api/loading.tsx",
    "web/tests/resident-rematch-browser.mjs",
    "web/src/game-api/registry.ts",
    "web/tests/retired-games.test.mjs",
    "web/tests/splendor-take-browser.mjs",
    "web/src/game-api/catalog-cover.tsx",
    "web/tests/catalog-covers.test.mjs",
    "internal/server/retired_independent_e2e_test.go",
    "web/src/ui/auth.tsx",
    "web/src/ui/auth.css",
    "web/tests/auth-page.test.mjs",
    "web/tests/auth-page-browser.test.mjs",
    "assets/game-covers.json",
    "games/retired_registry_test.go",
    "web/src/ui/lobby-theme.css",
    "web/tests/room-flow-browser.test.mjs"
  ],
  "patterns": [
    {
      "directory": "web/tests",
      "filename": "^audio-spatial(?:[.-][a-z0-9]+)*\\.test\\.mjs$"
    }
  ],
  "patchSources": [
    "web/src/audio.ts",
    "web/src/game-api/module.ts",
    "web/src/game-api/host.tsx",
    "web/src/main.tsx",
    "web/src/realtime-stream.ts",
    "web/src/legacy/room-ui.tsx",
    "web/src/chat.tsx",
    "web/tests/mobile-play-notice.test.mjs",
    "web/tests/module-horizontal-players.test.mjs",
    "web/tests/module-pause.test.mjs",
    "web/tests/module-preparation.test.mjs",
    "web/src/audio-silence.ts",
    "web/tests/audio-silence.test.mjs",
    "web/tests/platform-audio-continuous.test.mjs",
    "web/vite.config.ts",
    "web/src/legacy/cover.tsx",
    "web/src/style.css",
    "games/registry.go"
  ],
  "platformAudioSources": [
    "web/src/audio-spatial.ts",
    "web/src/audio.ts"
  ],
  "businessSources": [
    "web/src/game-api/default-players.ts",
    "web/src/game-api/action-scope.ts",
    "web/src/realtime-stream.ts"
  ],
  "localOutputRoots": [
    ".local/cs16",
    ".local/yuyuhakusho",
    ".local/conquest",
    ".local/stoneage",
    ".local/splendor",
    ".local/go-build",
    ".local/go-mod",
    ".local/_common",
    ".local/platform-lint",
    ".local/room-flow",
    ".local/rft"
  ],
  "filename": "^(?:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.(?:tsx?|mjs|json|css)|[A-Z][A-Za-z0-9]*\\.tsx)$",
  "rules": [
    "camelCase/PascalCase bindings; kebab-case web filenames/classes and snake_case Go filenames with package matching the registered directory",
    "No code comments, TypeScript any or dynamic execution",
    "No imports from games or workspace escape",
    "Integer or fixed-point numeric comparison operands in businessSources; pure floating storage and calculation are allowed, while tolerance/extrema/sorting cannot hide floating comparison",
    "AudioContext physical destination cannot receive output; platformAudioSources use a native MediaStream destination",
    "Only declared platform audio may create native audio players or AudioContext",
    "All temporary output is explicitly in a declared local workspace root",
    "Existing sources inspect added lines only; new sources are inspected in full"
  ],
  "goFilename": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*\\.go$",
  "goPackages": {
    "internal/server": "server",
    "games": "games"
  }
}
