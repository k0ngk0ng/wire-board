{
  "scope": "仅资源发布、复用、历史 HTTP 跳转与涉及的资源入口，不代表全仓库 lint",
  "directories": [
    "scripts/",
    "internal/server/",
    "web/src/",
    "web/scripts/",
    "web/tests/",
    "games/racing/",
    "games/contra/web/",
    "games/pvz/web/",
    "games/yuyuhakusho/web/",
    "games/basketball/web/"
  ],
  "allowUpperSnakeConstants": true,
  "evidenceDirectory": ".local/asset-reuse/lint",
  "files": [
    "scripts/asset_reuse.py",
    "scripts/cdn_delivery.py",
    "scripts/asset_reuse_e2e_test.py",
    "internal/server/static_media.go",
    "internal/server/static_media_reuse_e2e_test.go",
    "web/src/main.tsx",
    "web/src/media-assets.ts",
    "web/scripts/game-load-manifest.mjs",
    "web/tests/media-assets.test.mjs",
    "web/tests/asset-reuse-lint.test.mjs",
    "games/racing/web/classic-loading.ts",
    "games/contra/web/runtime-url.ts",
    "games/pvz/web/art.ts",
    "games/pvz/web/runtime.ts",
    "games/yuyuhakusho/web/release-assets.ts",
    "games/racing/build/lint.mjs",
    "games/racing/build/lint_go.go",
    "games/racing/build/lint_python.py",
    "internal/server/static_delivery.go",
    "games/racing/web/classic-assets.ts",
    "games/basketball/web/asset-base.ts",
    "games/basketball/web/Cover.tsx",
    "scripts/test_cdn_delivery.py",
    "scripts/cdn_local_ready.py",
    "games/contra/web/runtime-url.test.mjs",
    "scripts/game-loading/check-build.mjs"
  ],
  "rules": [
    "Go/Python 文件 snake_case，JS/TS 文件 kebab-case",
    "Go 包名匹配目录；函数、类型和绑定 CamelCase",
    "Python 变量及函数 snake_case，类 PascalCase，常量 UPPER_SNAKE_CASE",
    "禁止代码注释、eval、exec 和 Function 构造器；Go embed 指令保留",
    "保留 unittest 与 HTTP 标准库约定的回调方法名",
    "React 组件 TSX 文件允许 PascalCase"
  ],
  "reactPascalCase": true
}
