  "languages": {
    ".ts": {
      "directory": "^(?:web/src/(?:controllers|ui)/|games/yuyuhakusho/web/|games/basketball/web/audio(?:-resources)?\\.ts$|games/stoneage/web/assets\\.ts$|games/(?:pal|pvz)/web/resident-assets\\.ts$)",
