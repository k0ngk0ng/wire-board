  "languages": {
    ".ts": {
      "directory": "^(?:web/src/controllers/|games/yuyuhakusho/web/)",
      "filename": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.ts$",
      "comments": false
    },
    ".tsx": {
      "directory": "^(?:web/src/controllers/|games/yuyuhakusho/(?:tests|web)/)",
      "filename": "^(?:[A-Z][A-Za-z0-9]*|module|catalog)\\.tsx$",
      "comments": false
    },
    ".mjs": {
      "directory": "^(?:games/yuyuhakusho/(?:tests|build)/|web/tests/)",
      "filename": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*\\.mjs$",
      "comments": false
    },
    ".css": {
      "directory": "^games/yuyuhakusho/web/",
      "filename": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.css$",
      "comments": false
    },
    ".go": {
      "directory": "^games/yuyuhakusho/(?:server|engine|sessiontick|platformtest|build)/",
      "filename": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*\\.go$",
      "comments": false
    }
  },
  "identifiers": "^(?:_?[A-Za-z][A-Za-z0-9]*|_|[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*)$"
}
