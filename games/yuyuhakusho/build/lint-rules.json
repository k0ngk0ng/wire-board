      "directory": "^(?:games/yuyuhakusho/(?:tests|build)/|web/tests/|games/basketball/tests/(?:audio(?:-resources)?\\.test|resident-gameplay-browser)\\.mjs$|games/stoneage/tests/resident-assets\\.test\\.mjs$|games/(?:pal|pvz)/tests/resident-assets\\.test\\.mjs$)",
