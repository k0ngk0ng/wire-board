      "comments": false
    },
    ".tsx": {
      "directory": "^(?:web/(?:src/controllers|tests)/|games/(?:yuyuhakusho|contra|basketball|battlecity|stoneage|pvz)/(?:tests|web)/)",
      "filename": "^(?:[A-Z][A-Za-z0-9]*|module|catalog|runtime-board)\\.tsx$",
      "comments": false
    },
