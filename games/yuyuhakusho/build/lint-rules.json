      "comments": false
    },
    ".css": {
      "directory": "^(?:web/src/controllers/|games/(?:yuyuhakusho|contra|basketball|battlecity)/web/)",
      "filename": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.css$",
      "comments": false
    },
    ".go": {
      "directory": "^(?:games/yuyuhakusho/(?:server|engine|sessiontick|platformtest|build)/|internal/gametest/)",
      "filename": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*\\.go$",
      "comments": false
    }
  },
