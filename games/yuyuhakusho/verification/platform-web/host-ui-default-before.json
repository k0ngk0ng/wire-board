  "defaultPlayers": "<div class=\"players-strip module-players\"><div class=\"player-panel \" data-player-seat=\"0\"><span class=\"avatar\" style=\"background:#b74134\">甲</span><div class=\"player-info\"><strong><button class=\"player-link player-name\" title=\"查看 甲 的玩家页面\">甲</button><span class=\"network-signal network-good\" data-network-bars=\"4\" title=\"甲：网络延迟 0 毫秒\" aria-label=\"甲：网络延迟 0 毫秒\" role=\"img\"><svg width=\"20\" height=\"17\" viewBox=\"0 0 20 17\" aria-hidden=\"true\"><rect x=\"0\" y=\"12\" width=\"3.5\" height=\"4\" rx=\".7\" class=\"lit\"></rect><rect x=\"5\" y=\"9\" width=\"3.5\" height=\"7\" rx=\".7\" class=\"lit\"></rect><rect x=\"10\" y=\"5\" width=\"3.5\" height=\"11\" rx=\".7\" class=\"lit\"></rect><rect x=\"15\" y=\"1\" width=\"3.5\" height=\"15\" rx=\".7\" class=\"lit\"></rect></svg><span class=\"network-delay\">0ms</span></span><small>你</small></strong><small>托管中</small></div><div class=\"player-extras\"><span data-contract-summary=\"true\">资源 0</span></div></div><div class=\"player-panel \" data-player-seat=\"1\"><span class=\"avatar\" style=\"background:#2c75a7\">乙</span><div class=\"player-info\"><strong><button class=\"player-link player-name\" title=\"查看 乙 的玩家页面\">乙</button></strong><small>已离桌</small></div><div class=\"player-extras\"><span data-contract-summary=\"true\">资源 23</span></div></div><div class=\"player-panel \" data-player-seat=\"2\"><span class=\"avatar\" style=\"background:#c8981c\">电</span><div class=\"player-info\"><strong><span class=\"player-name\" title=\"电脑\">电脑</span></strong><small>已入座</small></div><div class=\"player-extras\"><span data-contract-summary=\"true\">资源 23</span></div></div><div class=\"player-panel \" data-player-seat=\"3\"><span class=\"avatar\" style=\"background:#368161\">丁</span><div class=\"player-info\"><strong><button class=\"player-link player-name\" title=\"查看 丁 的玩家页面\">丁</button></strong><small>已出局</small></div><div class=\"player-extras\"><span data-contract-summary=\"true\">资源 23</span>